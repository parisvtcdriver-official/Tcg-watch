# Copie ce fichier en .env pour tester en local (npx netlify dev).
# En production, ces variables se definissent avec :
#   netlify env:set NOM_DE_LA_VARIABLE "valeur"
# (ou dans l'interface Netlify : Site settings -> Environment variables)

# Base de donnees Turso (turso.tech, gratuit, sans carte bancaire) :
#   turso db create tcg-watch
#   turso db show tcg-watch --url          -> TURSO_DATABASE_URL
#   turso db tokens create tcg-watch       -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Mot de passe de l'app (optionnel, mais recommande une fois publique)
APP_TOKEN=

# Resend (resend.com, gratuit jusqu'a 3000 mails/mois)
RESEND_API_KEY=
ALERT_FROM=TCG Watch <onboarding@resend.dev>

# Notifications push (genere une seule fois, voir scripts/generate-vapid-keys.mjs)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=
VAPID_SUBJECT=mailto:parisvtcdriver@gmail.com

# Adresse publique de l'app une fois deployee (pour le lien "Ouvrir l'app" dans les mails)
APP_URL=
